<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.MyStudentsCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <VBox spacing="18" styleClass="page">
         <children>
            <VBox spacing="4">
               <children>
                  <Label styleClass="page-title" text="My Students" />
                  <Label styleClass="page-subtitle" text="Students enrolled in your courses." wrapText="true" />
               </children>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="search-box" HBox.hgrow="ALWAYS">
                     <children>
                        <Region id="icon-search" styleClass="icon" />
                        <TextField fx:id="searchField" promptText="Search" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="courseCombo" prefWidth="230.0" promptText="All courses" />
                  <Button mnemonicParsing="false" onAction="#showAllStudents" styleClass="btn-ghost" text="Show all" />
                  <Label fx:id="countLabel" styleClass="muted" />
               </children>
            </HBox>

            <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Student" />
                  <TableColumn fx:id="emailColumn" prefWidth="240.0" text="Email" />
                  <TableColumn fx:id="courseColumn" prefWidth="200.0" text="Course" />
                  <TableColumn fx:id="paymentColumn" prefWidth="130.0" text="Payment" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
