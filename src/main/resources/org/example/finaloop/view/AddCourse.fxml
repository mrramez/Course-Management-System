<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.AddCourseCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <ScrollPane fitToWidth="true" styleClass="page-scroll">
         <content>
            <VBox spacing="20" styleClass="page">
               <children>
                  <VBox spacing="4">
                     <children>
                        <Label fx:id="titleLabel" styleClass="page-title" text="Add Course" />
                        <Label fx:id="subtitleLabel" styleClass="page-subtitle" text="Enter the course details and choose the trainer." wrapText="true" />
                     </children>
                  </VBox>

                  <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

                  <HBox spacing="20">
                     <children>
                        <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="section-title" text="Course Details" />

                              <VBox spacing="6">
                                 <children>
                                    <Label styleClass="field-label" text="Course name" />
                                    <TextField fx:id="nameField" promptText="Course name" />
                                    <Label fx:id="nameError" managed="false" styleClass="field-error" visible="false" />
                                 </children>
                              </VBox>

                              <VBox spacing="6">
                                 <children>
                                    <Label styleClass="field-label" text="Description" />
                                    <TextArea fx:id="descriptionArea" prefRowCount="5" promptText="Course description" wrapText="true" />
                                    <Label fx:id="descriptionHint" styleClass="field-hint" text="0 / 2000" />
                                 </children>
                              </VBox>

                              <HBox spacing="16">
                                 <children>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="field-label" text="Price (SAR)" />
                                          <TextField fx:id="priceField" promptText="199.99" />
                                          <Label fx:id="priceError" managed="false" styleClass="field-error" visible="false" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="field-label" text="Trainer" />
                                          <ComboBox fx:id="trainerCombo" maxWidth="Infinity" promptText="Choose a trainer" />
                                          <Label fx:id="trainerError" managed="false" styleClass="field-error" visible="false" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <Label fx:id="noTrainersHint" managed="false" styleClass="field-hint" text="No trainers yet. A trainer must sign up first." visible="false" wrapText="true" />
                           </children>
                        </VBox>

                        <VBox minWidth="340.0" prefWidth="340.0" spacing="12" styleClass="card">
                           <children>
                              <Label styleClass="section-title" text="Course Image" />
                              <StackPane fx:id="coverPreviewBox" />
                              <Label styleClass="field-hint" text="PNG or JPG (optional)" wrapText="true" />
                              <HBox spacing="8">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#chooseImage" text="Choose image">
                                       <graphic>
                                          <Region id="icon-image" styleClass="icon" />
                                       </graphic>
                                    </Button>
                                    <Button fx:id="removeImageButton" mnemonicParsing="false" onAction="#removeImage" styleClass="btn-ghost" text="Remove" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_RIGHT" spacing="10">
                     <children>
                        <Button mnemonicParsing="false" onAction="#back" text="Cancel" />
                        <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#saveCourse" styleClass="btn-primary" text="Add Course" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
