<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.AdminDashboardCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <ScrollPane fitToWidth="true" styleClass="page-scroll">
         <content>
            <VBox spacing="22" styleClass="page">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16">
                     <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="page-title" text="Dashboard" />
                              <Label fx:id="welcomeLabel" styleClass="page-subtitle" wrapText="true" />
                           </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#addCourse" styleClass="btn-primary" text="Add Course">
                           <graphic>
                              <Region id="icon-plus" styleClass="icon" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>

                  <HBox spacing="16">
                     <children>
                        <VBox maxWidth="Infinity" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="stat-label" text="Courses" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon">
                                       <children>
                                          <Region id="icon-book" styleClass="icon" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="coursesCountLabel" styleClass="stat-value" text="0" />
                           </children>
                        </VBox>
                        <VBox maxWidth="Infinity" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="stat-label" text="Trainers" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon">
                                       <children>
                                          <Region id="icon-users" styleClass="icon" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="trainersCountLabel" styleClass="stat-value" text="0" />
                           </children>
                        </VBox>
                        <VBox maxWidth="Infinity" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="stat-label" text="Students" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon">
                                       <children>
                                          <Region id="icon-user" styleClass="icon" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="studentsCountLabel" styleClass="stat-value" text="0" />
                           </children>
                        </VBox>
                        <VBox maxWidth="Infinity" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="stat-label" text="Enrollments" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon">
                                       <children>
                                          <Region id="icon-check" styleClass="icon" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <Label fx:id="enrollmentsCountLabel" styleClass="stat-value" text="0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="16">
                     <children>
                        <VBox spacing="6" styleClass="card" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="section-title" text="Recent Courses" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Hyperlink onAction="#viewCourses" text="View all" />
                                 </children>
                              </HBox>
                              <VBox fx:id="recentBox" />
                           </children>
                        </VBox>

                        <VBox minWidth="300.0" prefWidth="320.0" spacing="10" styleClass="card">
                           <children>
                              <Label styleClass="section-title" text="Quick Actions" />
                              <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#addCourse" styleClass="action-card" text="Add a new course">
                                 <graphic>
                                    <Region id="icon-plus" styleClass="icon" />
                                 </graphic>
                              </Button>
                              <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#viewCourses" styleClass="action-card" text="Edit or delete courses">
                                 <graphic>
                                    <Region id="icon-edit" styleClass="icon" />
                                 </graphic>
                              </Button>                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
