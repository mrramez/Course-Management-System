<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="12" styleClass="dialog-root" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.ReviewPopupCtrl">
   <children>
      <Label fx:id="courseNameLabel" styleClass="section-title" text="Review Course" wrapText="true" />

      <HBox fx:id="starsBox" alignment="CENTER_LEFT" spacing="2" />
      <Label fx:id="ratingText" styleClass="secondary-text" />

      <Label styleClass="field-label" text="Comment:" />
      <TextArea fx:id="commentArea" prefRowCount="4" promptText="Write your thoughts about the course..." wrapText="true" />

      <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

      <HBox alignment="CENTER_RIGHT" spacing="10">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#cancel" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#submitReview" styleClass="btn-primary" text="Submit" />
         </children>
      </HBox>
   </children>
</VBox>
