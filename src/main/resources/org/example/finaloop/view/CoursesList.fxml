<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.CoursesListCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <VBox spacing="18" styleClass="page">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16">
               <children>
                  <VBox spacing="4" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="page-title" text="Courses" />
                        <Label styleClass="page-subtitle" text="All courses in the system." wrapText="true" />
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#addCourse" styleClass="btn-primary" text="Add Course">
                     <graphic>
                        <Region id="icon-plus" styleClass="icon" />
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

            <HBox alignment="CENTER_LEFT" spacing="12">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="search-box" HBox.hgrow="ALWAYS">
                     <children>
                        <Region id="icon-search" styleClass="icon" />
                        <TextField fx:id="searchField" promptText="Search" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="trainerFilter" prefWidth="210.0" />
                  <Label fx:id="countLabel" styleClass="muted" />
               </children>
            </HBox>

            <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="courseColumn" minWidth="240.0" prefWidth="320.0" text="Course" />
                  <TableColumn fx:id="trainerColumn" minWidth="110.0" prefWidth="140.0" text="Trainer" />
                  <TableColumn fx:id="studentsColumn" minWidth="80.0" prefWidth="80.0" text="Students" />
                  <TableColumn fx:id="priceColumn" minWidth="90.0" prefWidth="100.0" text="Price" />
                  <TableColumn fx:id="actionColumn" minWidth="200.0" prefWidth="200.0" sortable="false" text="" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
