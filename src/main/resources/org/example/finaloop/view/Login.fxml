<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="auth-panel" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.LoginCtrl">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="360.0" spacing="14">
         <children>
            <Hyperlink onAction="#startback" text="Back" />
            <Label styleClass="auth-title" text="Login" />

            <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

            <VBox spacing="6">
               <children>
                  <Label styleClass="field-label" text="Email" />
                  <TextField fx:id="emailField" promptText="Email" />
               </children>
            </VBox>
            <VBox spacing="6">
               <children>
                  <Label styleClass="field-label" text="Password" />
                  <HBox alignment="CENTER_LEFT" styleClass="password-box">
                     <children>
                        <PasswordField fx:id="passwordField" promptText="Password" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="passwordText" managed="false" promptText="Password" visible="false" HBox.hgrow="ALWAYS" />
                        <Button fx:id="eyeButton" focusTraversable="false" mnemonicParsing="false" onAction="#showPassword" styleClass="icon-button" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <CheckBox fx:id="rememberCheck" mnemonicParsing="false" text="Remember me" />

            <Button defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLogin" styleClass="btn-primary, btn-large" text="Login" />

            <HBox alignment="CENTER" spacing="6">
               <children>
                  <Label styleClass="muted" text="Don't have an account?" />
                  <Hyperlink onAction="#goSignup" text="Sign up" />
               </children>
            </HBox>
         </children>
      </VBox>

      <Button fx:id="themeButton" mnemonicParsing="false" styleClass="btn-ghost" StackPane.alignment="TOP_RIGHT" />
   </children>
</StackPane>
