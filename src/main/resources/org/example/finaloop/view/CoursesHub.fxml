<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.CoursesHubCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <ScrollPane fitToWidth="true" styleClass="page-scroll">
         <content>
            <VBox spacing="20" styleClass="page">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="16">
                     <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="pageTitle" styleClass="page-title" text="Browse courses" />
                              <Label fx:id="pageSubtitle" styleClass="page-subtitle" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox fx:id="tabsBox" styleClass="segmented">
                           <children>
                              <Button fx:id="browseTabBtn" mnemonicParsing="false" onAction="#showBrowseTab" styleClass="segment" text="Browse Courses" />
                              <Button fx:id="myCoursesTabBtn" mnemonicParsing="false" onAction="#showMyCoursesTab" styleClass="segment" text="My Courses" />
                           </children>
                        </HBox>
                        <HBox fx:id="guestActions" managed="false" spacing="10" visible="false">
                           <children>
                              <Button mnemonicParsing="false" onAction="#goSignIn" text="Login" />
                              <Button mnemonicParsing="false" onAction="#goSignUp" styleClass="btn-primary" text="Sign up" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

                  <VBox fx:id="browsePane" spacing="16">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                           <children>
                              <HBox alignment="CENTER_LEFT" styleClass="search-box" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Region id="icon-search" styleClass="icon" />
                                    <TextField fx:id="searchField" promptText="Search" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Label fx:id="resultsLabel" styleClass="muted" />
                           </children>
                        </HBox>
                        <FlowPane fx:id="coursesFlowPane" hgap="18.0" vgap="18.0" />
                     </children>
                  </VBox>

                  <VBox fx:id="myCoursesPane" spacing="12" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
