<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app" stylesheets="@../styles/theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finaloop.controller.AttendanceCtrl">
   <left>
      <fx:include source="Sidebar.fxml" />
   </left>
   <center>
      <VBox spacing="16" styleClass="page">
         <children>
            <VBox spacing="4">
               <children>
                  <Label styleClass="page-title" text="Attendance" />
                  <Label styleClass="page-subtitle" text="Choose the course and the date, uncheck the absent students, then press Save." wrapText="true" />
               </children>
            </VBox>

            <HBox alignment="BOTTOM_LEFT" spacing="12">
               <children>
                  <VBox spacing="6">
                     <children>
                        <Label styleClass="field-label" text="Course" />
                        <ComboBox fx:id="courseCombo" prefWidth="240.0" promptText="Choose a course" />
                     </children>
                  </VBox>
                  <VBox spacing="6">
                     <children>
                        <Label styleClass="field-label" text="Date" />
                        <DatePicker fx:id="datePicker" prefWidth="170.0" />
                     </children>
                  </VBox>
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="field-label" text="Find a student" />
                        <HBox alignment="CENTER_LEFT" styleClass="search-box">
                           <children>
                              <Region id="icon-search" styleClass="icon" />
                              <TextField fx:id="searchField" promptText="Search" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Label fx:id="statusLabel" managed="false" maxWidth="Infinity" styleClass="banner" visible="false" wrapText="true" />

            <HBox alignment="CENTER_LEFT" spacing="8">
               <children>
                  <Label fx:id="presentChip" styleClass="badge, badge-success, chip" text="Present 0" />
                  <Label fx:id="absentChip" styleClass="badge, badge-danger, chip" text="Absent 0" />
                  <Label fx:id="totalChip" styleClass="badge, badge-neutral, chip" text="Total 0" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="savedInfo" styleClass="muted" />
               </children>
            </HBox>

            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="nameColumn" prefWidth="320.0" text="Student" />
                  <TableColumn fx:id="savedColumn" prefWidth="180.0" text="Saved status" />
                  <TableColumn fx:id="presentColumn" prefWidth="120.0" text="Present" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <Button mnemonicParsing="false" onAction="#markAllPresent" text="Mark all present">
                     <graphic>
                        <Region id="icon-check" styleClass="icon" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#markAllAbsent" text="Mark all absent" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveAttendance" styleClass="btn-primary, btn-large" text="Save" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
